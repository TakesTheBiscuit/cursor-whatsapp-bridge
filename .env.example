# Absolute path the Cursor agent should edit. Defaults to this repo.
# WORKSPACE_PATH=/home/paul/code/my-long-running-project

# From https://cursor.com/dashboard/integrations (or `agent login` in this environment).
CURSOR_API_KEY=

# Optional. Example: composer-2.5, auto
# CURSOR_MODEL=

# Optional. Defaults to `agent`, then `cursor-agent` on PATH.
# CURSOR_BIN=agent

# Minutes a Cursor CLI run may sit with work waiting before a wake-up nudge.
# STUCK_MINUTES=10
